{
  "expo": {
    "name": "RemindMe",
    "slug": "remind-me-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.remindme.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1E293B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6366F1",
          "defaultChannel": "reminders-channel"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RemindersWidget",
              "label": "RemindMe Widget",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "View upcoming reminders and active intervals on your home screen",
              "previewImage": "./assets/icon.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/7d6d6e88-c074-4a33-928f-d2ef22f0fb0f"
    },
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "7d6d6e88-c074-4a33-928f-d2ef22f0fb0f"
      }
    }
  }
}
